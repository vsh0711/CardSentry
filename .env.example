# Copy to .env and fill in for live/cloud mode. Without these, everything
# falls back to local defaults (SQLite db, local Kafka on localhost:9092).

# --- Kafka (Redpanda Serverless free tier) ---
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_TOPIC=cardsentry-transactions

# --- Postgres (Neon free tier) — shared transaction history for API + dashboard ---
DATABASE_URL=

# --- Redis (Upstash free tier) — Feast online feature store ---
FEAST_REDIS_URL=

# --- Producer tuning ---
PRODUCER_EVENTS_PER_SEC=20
PRODUCER_TOTAL_EVENTS=0
